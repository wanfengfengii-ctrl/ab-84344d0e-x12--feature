# Host-side published port for the API container.
# Usage: HOST_PORT=9090 docker compose up --build -d api
HOST_PORT=8080

# Optional trading-partner profiles (JSON array, 1..16 unique entries).
# Each entry declares ISA05/06/07/08, GS02/03 and 1..8 group contracts of
# GS01 + GS08 + allowed ST01 codes.  Select per request with the
# X-Partner-Profile header; leave blank/unset to disable profiling.
# Invalid JSON makes the api process exit non-zero at startup.
#
# X12_PARTNER_PROFILES='[{"name":"acme","ISA05":"ZZ","ISA06":"ACME","ISA07":"ZZ","ISA08":"PLATFORM","GS02":"ACME","GS03":"PLATFORM","groups":[{"GS01":"PO","GS08":"005010","ST01":["850","855"]}]}]'
